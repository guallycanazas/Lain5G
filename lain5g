def _app_command(service: ProfileConfigService, argv: list[str]) -> int:
    if not argv:
        _app_menu(service)
        return 0
    aliases = {
        "install": "setup",
        "prepare": "setup",
        "up": "start",
        "ps": "status",
        "log": "logs",
        "down": "stop",
    }
    action = aliases.get(argv[0], argv[0])
    flags = set(argv[1:])
    allowed_flags = {
        "setup": {"--operations"},
        "build": set(),
        "start": {"--operations", "--open"},
        "open": set(),
        "status": {"--operations"},
        "logs": {"--operations"},
        "stop": {"--operations"},
    }.get(action, set())
    if action not in {"setup", "build", "start", "open", "status", "logs", "stop"} or not flags <= allowed_flags:
        print(
            "Uso: lain5g app setup|build|start|open|status|logs|stop [--operations] [--open]",
            file=sys.stderr,
        )
        return 2

    operations = "--operations" in flags
    if action not in {"setup", "start", "stop"}:
        return _run_app_command(service, action, flags, operations)

    lock_fd = os.open(service.root, os.O_RDONLY)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Hay un inicio RF en curso; no se modifico la aplicacion.", file=sys.stderr)
            return 1
        return _run_app_command(service, action, flags, operations)
    finally:
        os.close(lock_fd)


def _run_app_command(service: ProfileConfigService, action: str, flags: set[str], operations: bool) -> int:
    active_rf = [path for path in RF_ACTIVE_MARKERS if (service.root / path).is_file()]
    if active_rf and action in {"setup", "start", "stop"}:
        print(
            "Hay una sesion RF activa. Ejecuta la parada de emergencia o espera su auto-stop antes de cerrar o degradar la app.",
            file=sys.stderr,
        )
        return 1
    app_environment = service.root / ".env.app"
    if action in {"setup", "start"} and app_environment.is_symlink():
        print("No se modifico .env.app porque es un enlace simbolico.", file=sys.stderr)
        return 1
    if action not in {"setup", "open"}:
        docker_accessible = shutil.which("docker") is not None and subprocess.run(
            ["docker", "info"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode == 0
        user = os.environ.get("SUDO_USER") or getpass.getuser() or pwd.getpwuid(os.getuid()).pw_name
        if not docker_accessible and "docker" in _group_names(user) and "docker" not in _group_names():
            print(
                "Docker aun no esta activo en esta terminal. Ejecuta 'newgrp docker' y repite el comando.",
                file=sys.stderr,
            )
            return 1
    if action in {"setup", "start"} and not operations and app_environment.is_file():
        completed = subprocess.run(["make", "app-down-operations"], cwd=service.root, check=False)
        if completed.returncode != 0:
            print("No se pudo detener la app operativa antes de preparar el modo seguro.", file=sys.stderr)
            return completed.returncode
    if action in {"setup", "start"}:
        if not _prepare_app_environment(service, operations=operations):
            return 1
    elif action == "build" and not (service.root / ".env.app").is_file():
        if not _prepare_app_environment(service, operations=False):
            return 1
    elif action != "open" and not (service.root / ".env.app").is_file():
        print("Falta .env.app. Ejecuta primero: ./lain5g app setup", file=sys.stderr)
        return 2

    if action == "setup":
        return 0
    if action == "open":
        return _open_app(service)

    target = {
        "build": "app-build",
        "start": "app-up-operations" if operations else "app-up",
        "status": "app-ps-operations",
        "logs": "app-logs-operations",
        "stop": "app-down-operations",
    }[action]
    if operations and action == "start":
        print("Modo operativo: el backend tendra acceso de escritura al proyecto y al socket Docker.")
    completed = subprocess.run(["make", target], cwd=service.root, check=False)
    if completed.returncode == 0 and action == "start" and "--open" in flags:
        if _open_app(service) != 0:
            print("La aplicacion esta iniciada; abre manualmente la URL indicada.")
        return 0
    return completed.returncode


def _prepare_app_environment(service: ProfileConfigService, *, operations: bool) -> bool:
    example = service.root / ".env.app.example"
    target = service.root / ".env.app"
    if target.is_symlink():
        print("No se modifico .env.app porque es un enlace simbolico.", file=sys.stderr)
        return False
    try:
        text = target.read_text(encoding="utf-8") if target.is_file() else example.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        print(f"No se pudo preparar .env.app: {exc}", file=sys.stderr)
        return False
    existing_values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            existing_values[key.strip()] = value.strip().strip("\"'")
    sim_programmer_token = existing_values.get("LAIN5G_SIM_PROGRAMMER_TOKEN", "") or secrets.token_urlsafe(32)
    pcsc_socket = existing_values.get("LAIN5G_PCSC_SOCKET", "/run/pcscd/pcscd.comm")
    pcsc_socket_path = Path(pcsc_socket)
    values = {
        "LAIN5G_PROJECT_ROOT": str(service.root.resolve()),
        "LAIN5G_MUTATING_OPERATIONS_ENABLED": "false",
        "LAIN5G_IMAGE_PULL_ENABLED": "false",
        "LAIN5G_RF_WEB_CONTROL_ENABLED": "false",
        "LAIN5G_SIM_PROGRAMMER_URL": "http://sim-programmer:8123",
        "LAIN5G_SIM_PROGRAMMER_TOKEN": sim_programmer_token,
        "LAIN5G_PCSC_SOCKET": pcsc_socket,
        "LAIN5G_PCSC_SOCKET_DIR": str(pcsc_socket_path.parent),
        "LAIN5G_PCSC_SOCKET_NAME": pcsc_socket_path.name,
    }
    if operations:
        values.update(
            {
                "LAIN5G_MUTATING_OPERATIONS_ENABLED": "true",
                "LAIN5G_IMAGE_PULL_ENABLED": "true",
                "LAIN5G_RF_WEB_CONTROL_ENABLED": "true",
            }
        )
    lines = text.splitlines()
    for key, value in values.items():
        replacement = f"{key}={value}"
        found = False
        normalized = []
        for line in lines:
            candidate = line.lstrip()
            if candidate.startswith("export "):
                candidate = candidate[7:].lstrip()
            if candidate.startswith(f"{key}="):
                if not found:
                    normalized.append(replacement)
                    found = True
                continue
            normalized.append(line)
        if not found:
            normalized.append(replacement)
        lines = normalized
    updated = "\n".join(lines) + "\n"
    temporary_path: Path | None = None
    try:
        if not target.is_file() or target.read_text(encoding="utf-8") != updated:
            with tempfile.NamedTemporaryFile(
                mode="w",
                encoding="utf-8",
                dir=target.parent,
                prefix=".env.app.",
                delete=False,
            ) as temporary:
                temporary_path = Path(temporary.name)
                temporary.write(updated)
                temporary.flush()
                os.fsync(temporary.fileno())
            temporary_path.chmod(0o600)
            os.replace(temporary_path, target)
            temporary_path = None
            print(f"Configuracion preparada: {target}")
        else:
            print(f"Configuracion lista: {target}")
        target.chmod(0o600)
    except (OSError, UnicodeError) as exc:
        print(f"No se pudo escribir .env.app: {exc}", file=sys.stderr)
        return False
    finally:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)
    if operations:
        print("Operaciones software y RF protegido habilitadas; completa todos los controles antes de transmitir.")
    return True


def _app_environment_values(service: ProfileConfigService) -> dict[str, str]:
    try:
        text = (service.root / ".env.app").read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return {}
    values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip("\"'")
    return values


def _open_app(service: ProfileConfigService) -> int:
    candidate = _app_environment_values(service).get("APP_FRONTEND_PORT", "8080")
    port = candidate if candidate.isdigit() and 1 <= int(candidate) <= 65535 else "8080"
    opener = shutil.which("xdg-open")
    url = f"http://127.0.0.1:{port}"
    if opener is None:
        print(f"Abre la aplicacion manualmente: {url}")
        return 1
    print(f"Abriendo {url}")
    return subprocess.run([opener, url], cwd=service.root, check=False).returncode



def main(argv: list[str]) -> int:
    project_root = Path(os.environ.get("LAIN5G_PROJECT_ROOT", Path(__file__).resolve().parent))
    service = ProfileConfigService(SimpleNamespace(project_root=project_root))
    if not argv:
        return _main_menu(service)
    if argv[0] in {"-h", "--help", "help"}:
        _print_help()
        return 0
    if argv[0] in {"--status", "status"}:
        if len(argv) != 1:
            print("Uso: lain5g status", file=sys.stderr)
            return 2
        return _installation_status(service)
    if argv[0] in {"version", "versions"}:
        return _version_command(service, argv[1:])
    if argv[0] == "uninstall":
        return _uninstall_command(service, argv[1:])
    if argv[0] in {"manager", "maintenance"}:
        if len(argv) != 1:
            print("Uso: lain5g manager", file=sys.stderr)
            return 2
        return _manager_menu(service)
    if argv[0] in {"bootstrap", "install", "prepare"}:
        flags = set(argv[1:])
        if not flags <= {"--yes", "--dry-run"}:
            print("Uso: lain5g bootstrap [--yes] [--dry-run]", file=sys.stderr)
            return 2
        return _bootstrap_machine(
            service,
            assume_yes="--yes" in flags,
            dry_run="--dry-run" in flags or os.environ.get("LAIN5G_DRY_RUN", "false").lower() == "true",
        )
    if argv[0] == "images":
        return _images_command(service, argv[1:])
    if argv[0] == "app":
        return _app_command(service, argv[1:])
    if argv[0] == "scenario":
        return _scenario_command(service, argv[1:])
    if argv[0] == "doctor":
        return _doctor(service, argv[1] if len(argv) > 1 else "")
    if argv[0] != "profile":
        _print_help(file=sys.stderr)
        return 2
    if len(argv) == 1:
        return _wizard(service)
    action = argv[1]
    profile_id = argv[2] if len(argv) > 2 else ""
    if profile_id and profile_id not in PUBLIC_PROFILE_IDS:
        print(f"Perfil desconocido: {profile_id}", file=sys.stderr)
        return 2
    try:
        if action == "list":
            _print_profiles(service)
            return 0
        if action == "wizard":
            return _wizard(service, profile_id)
        if action in {"-h", "--help", "help"}:
            _print_help()
            return 0
        if not profile_id:
            print("Missing profile id", file=sys.stderr)
            return 2
        if action == "show":
            print(json.dumps(service.get_profile(profile_id), indent=2, sort_keys=True))
            return 0
        if action == "validate":
            result = service.validate_profile(profile_id)
            _print_validation(result)
            return 0 if result["valid"] else 1
        if action == "diff":
            for item in service.diff_profile(profile_id)["files"]:
                if item["changed"]:
                    print(item["diff"], end="")
            return 0
        if action == "configure":
            profile = service.get_profile(profile_id)
            _print_profile_header(profile_id)
            _edit_profile(profile_id, profile)
            updated = service.update_profile(profile_id, profile)
            print(f"\nSaved profile: {updated['profile']}")
            return 0
        if action == "apply":
            validation = service.validate_profile(profile_id)
            _print_validation(validation)
            if not validation["valid"]:
                return 1
            diff = service.diff_profile(profile_id)
            changed = [item for item in diff["files"] if item["changed"]]
            print(f"{len(changed)} files will be modified.")
            answer = _input("Apply changes? [y/N] ").strip().lower()
            if answer not in {"y", "yes"}:
                print("Aborted.")
                return 1
            print(json.dumps(service.apply_profile(profile_id), indent=2, sort_keys=True))
            return 0
        if action == "restore":
            print(json.dumps(service.restore_profile(profile_id), indent=2, sort_keys=True))
            return 0
    except ProfileConfigError as exc:
        print(f"{exc.code}: {exc.message}", file=sys.stderr)
        return 1 if exc.status_code < 500 else 2
    except ValueError as exc:
        print(f"INVALID_INPUT: {exc}", file=sys.stderr)
        return 2
    print(f"Unknown action: {action}", file=sys.stderr)
    return 2



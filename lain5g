def _run_bootstrap_step(command: list[str], *, dry_run: bool) -> bool:
    print(f"$ {shlex.join(command)}", flush=True)
    if dry_run:
        return True
    try:
        return subprocess.run(command, check=False).returncode == 0
    except KeyboardInterrupt:
        print("\nComando interrumpido.", file=sys.stderr)
        return False
    except (FileNotFoundError, PermissionError, OSError) as exc:
        print(f"ERROR: no se pudo ejecutar {command[0]}: {exc}", file=sys.stderr)
        return False


def _bootstrap_package_manager() -> str:
    forced = os.environ.get("LAIN5G_BOOTSTRAP_PACKAGE_MANAGER", "").strip()
    if forced:
        return forced if forced in {"apt-get", "dnf", "pacman", "zypper"} else ""
    return next((name for name in ("apt-get", "dnf", "pacman", "zypper") if shutil.which(name)), "")


def _apt_compose_package(*, dry_run: bool) -> str:
    if dry_run or shutil.which("apt-cache") is None:
        return "docker-compose-v2"
    for candidate in ("docker-compose-v2", "docker-compose-plugin"):
        if subprocess.run(
            ["apt-cache", "show", candidate],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode == 0:
            return candidate
    return "docker-compose-v2"


def _apt_venv_package(*, dry_run: bool) -> str:
    versioned = f"python{sys.version_info.major}.{sys.version_info.minor}-venv"
    if dry_run or shutil.which("apt-cache") is None:
        return versioned
    for candidate in (versioned, "python3-venv"):
        if subprocess.run(
            ["apt-cache", "show", candidate],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode == 0:
            return candidate
    return "python3-venv"


def _group_names(user: str = "") -> set[str]:
    if shutil.which("id") is None:
        return set()
    command = ["id", "-nG"]
    if user:
        command.append(user)
    return set(subprocess.run(command, text=True, capture_output=True, check=False).stdout.split())


def _bootstrap_install_commands(manager: str, features: set[str], privileged: list[str], *, dry_run: bool) -> list[list[str]]:
    packages: list[str] = []
    if manager == "apt-get":
        if "python" in features:
            packages.append("python3")
        if "venv" in features:
            packages.append(_apt_venv_package(dry_run=dry_run))
        if "node" in features:
            packages.append("nodejs")
        if "npm" in features:
            packages.append("npm")
        if "git" in features:
            packages.append("git")
        if "make" in features:
            packages.append("make")
        if "docker" in features:
            packages.append("docker.io")
        if "util-linux" in features:
            packages.append("util-linux")
        if "compose" in features:
            packages.append(_apt_compose_package(dry_run=dry_run))
        if "pcsc" in features:
            packages.extend(_pcsc_packages(manager))
        return [[*privileged, "apt-get", "update"], [*privileged, "apt-get", "install", "-y", *packages]]
    mappings = {
        "dnf": {"python": "python3", "venv": "python3", "node": "nodejs", "npm": "npm", "git": "git", "make": "make", "docker": "moby-engine", "util-linux": "util-linux", "compose": "docker-compose-plugin"},
        "pacman": {"python": "python", "venv": "python", "node": "nodejs", "npm": "npm", "git": "git", "make": "make", "docker": "docker", "util-linux": "util-linux", "compose": "docker-compose"},
        "zypper": {"python": "python3", "venv": "python3-venv", "node": "nodejs", "npm": "npm", "git": "git", "make": "make", "docker": "docker", "util-linux": "util-linux", "compose": "docker-compose"},
    }
    ordered_features = ("python", "venv", "node", "npm", "git", "make", "docker", "util-linux", "compose")
    packages = list(dict.fromkeys(mappings.get(manager, {}).get(feature, feature) for feature in ordered_features if feature in features))
    if "pcsc" in features:
        packages.extend(_pcsc_packages(manager))
    if manager == "dnf":
        return [[*privileged, "dnf", "install", "-y", *packages]]
    if manager == "pacman":
        return [[*privileged, "pacman", "-Sy", "--needed", "--noconfirm", *packages]]
    if manager == "zypper":
        return [[*privileged, "zypper", "--non-interactive", "install", *packages]]
    return []


def _pcsc_packages(manager: str) -> list[str]:
    packages = {
        "apt-get": ["pcscd", "libccid"],
        "dnf": ["pcsc-lite", "pcsc-lite-ccid"],
        "pacman": ["pcsclite", "ccid"],
        "zypper": ["pcsc-lite", "pcsc-ccid"],
    }
    return packages.get(manager, [])


def _host_package_installed(manager: str, package: str) -> bool:
    if manager == "apt-get":
        command = ["dpkg-query", "-W", "-f=${db:Status-Status}", package]
    elif manager == "pacman":
        command = ["pacman", "-Q", package]
    else:
        command = ["rpm", "-q", package]
    try:
        result = subprocess.run(command, text=True, capture_output=True, check=False, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and (manager != "apt-get" or result.stdout.strip() == "installed")


def _ensure_pcsc_host(socket_path: str) -> bool:
    if Path(socket_path).is_socket():
        print(f"PC/SC host socket ready: {socket_path}")
        return True

    manager = _bootstrap_package_manager()
    packages = _pcsc_packages(manager)
    if not manager or not packages:
        print("AVISO: gestor no compatible para instalar PC/SC (apt-get, dnf, pacman o zypper).", file=sys.stderr)
        return False

    missing = [package for package in packages if not _host_package_installed(manager, package)]
    if missing:
        print(
            f"AVISO: faltan dependencias PC/SC ({', '.join(missing)}). Ejecuta ./install.sh para habilitar el lector SIM.",
            file=sys.stderr,
        )
        return False
    privileged: list[str] = []
    if os.geteuid() != 0:
        if shutil.which("sudo") is None:
            print("AVISO: sudo es necesario para activar el servicio PC/SC.", file=sys.stderr)
            return False
        privileged = ["sudo"]

    print("Dependencias PC/SC del host: OK")

    service_started = False
    if shutil.which("systemctl"):
        for command in (
            [*privileged, "systemctl", "enable", "--now", "pcscd.socket"],
            [*privileged, "systemctl", "start", "pcscd.service"],
        ):
            if _run_bootstrap_step(command, dry_run=False):
                service_started = True
                break
    elif shutil.which("service"):
        service_started = _run_bootstrap_step([*privileged, "service", "pcscd", "start"], dry_run=False)
    else:
        print("AVISO: no se encontro systemctl ni service para iniciar pcscd.", file=sys.stderr)
        return False

    if service_started:
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if Path(socket_path).is_socket():
                print(f"PC/SC listo: {socket_path}")
                return True
            time.sleep(0.25)

    print(f"AVISO: pcscd no creo el socket {socket_path}. Comprueba el lector y la configuracion PC/SC.", file=sys.stderr)
    return False


def _bootstrap_host_type() -> str:
    detector = shutil.which("systemd-detect-virt")
    if detector is None:
        return "undetermined (systemd-detect-virt is unavailable)"
    for option, label in (("--vm", "virtual machine"), ("--container", "container")):
        try:
            result = subprocess.run(
                [detector, option], text=True, capture_output=True, check=False, timeout=3
            )
        except (OSError, subprocess.TimeoutExpired):
            return "undetermined (virtualization detection failed)"
        if result.returncode == 0:
            technology = result.stdout.strip()
            translated_label = "maquina virtual" if label == "virtual machine" else "contenedor"
            return f"{translated_label} ({technology})" if technology else translated_label
    return "maquina fisica (no se detecto VM ni contenedor)"


def _bootstrap_elapsed_seconds(started_monotonic: float) -> int:
    try:
        started_at = float(os.environ.get("LAIN5G_INSTALL_STARTED_AT", ""))
    except ValueError:
        started_at = 0
    if started_at > 0:
        return max(0, int(time.time() - started_at))
    return max(0, int(time.monotonic() - started_monotonic))


def _bootstrap_machine(service: ProfileConfigService, *, assume_yes: bool = False, dry_run: bool = False) -> int:
    started_monotonic = time.monotonic()
    print("\nPreparacion completa de Lain5G-Lab")
    print("===================================")
    print("Instala herramientas base, soporte PC/SC para SIM, activa Docker y prepara configuraciones e imagenes del laboratorio.")
    if dry_run:
        print("MODO DRY-RUN: solo se mostraran los comandos.")
    if not assume_yes and not dry_run and not _confirm("Continuar con la preparacion del sistema?", default=True):
        print("Preparacion cancelada.")
        return 1

    forced_missing = {item.strip() for item in os.environ.get("LAIN5G_BOOTSTRAP_FORCE_MISSING", "").split(",") if item.strip()}
    docker_present = shutil.which("docker") is not None and "docker" not in forced_missing
    compose_present = docker_present and "compose" not in forced_missing and subprocess.run(
        ["docker", "compose", "version"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0
    docker_accessible = docker_present and subprocess.run(
        ["docker", "info"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0
    features = set()
    if sys.version_info < (3, 10) or "python" in forced_missing:
        features.add("python")
    venv_present = "venv" not in forced_missing and subprocess.run(
        [sys.executable, "-c", "import ensurepip, venv"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0
    if not venv_present:
        features.add("venv")
    if shutil.which("node") is None or "node" in forced_missing:
        features.add("node")
    if shutil.which("npm") is None or "npm" in forced_missing:
        features.add("npm")
    if shutil.which("git") is None or "git" in forced_missing:
        features.add("git")
    if shutil.which("make") is None or "make" in forced_missing:
        features.add("make")
    if shutil.which("flock") is None or "util-linux" in forced_missing:
        features.add("util-linux")
    if not docker_present:
        features.add("docker")
    if not compose_present:
        features.add("compose")

    manager = _bootstrap_package_manager()
    pcsc_packages = _pcsc_packages(manager)
    if pcsc_packages and (
        "pcsc" in forced_missing
        or any(not _host_package_installed(manager, package) for package in pcsc_packages)
    ):
        features.add("pcsc")

    privileged: list[str] = []
    if os.geteuid() != 0:
        if shutil.which("sudo") is None and not dry_run and (features or not docker_accessible):
            print("ERROR: se necesita sudo para instalar paquetes del sistema.", file=sys.stderr)
            return 2
        privileged = ["sudo"]

    ensured_dependencies: list[str] = []
    if features:
        if not manager:
            print("ERROR: gestor compatible no encontrado (apt-get, dnf, pacman o zypper).", file=sys.stderr)
            return 2
        print(f"\nInstalando dependencias con {manager}: {', '.join(sorted(features))}")
        dependency_labels = {
            "python": "Python 3.10+",
            "venv": "Python venv/ensurepip",
            "node": "Node.js",
            "npm": "npm",
            "git": "Git",
            "make": "GNU Make",
            "docker": "Docker Engine",
            "util-linux": "flock (util-linux)",
            "compose": "Docker Compose v2",
            "pcsc": "PC/SC daemon y controlador CCID para SIM",
        }
        ensured_dependencies = [dependency_labels.get(feature, feature) for feature in sorted(features)]
        for command in _bootstrap_install_commands(manager, features, privileged, dry_run=dry_run):
            if not _run_bootstrap_step(command, dry_run=dry_run):
                print("ERROR: fallo la instalacion de dependencias.", file=sys.stderr)
                return 1
        if not dry_run and "venv" in features and subprocess.run(
            [sys.executable, "-c", "import ensurepip, venv"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode != 0:
            print("ERROR: Python sigue sin soporte venv despues de instalar dependencias.", file=sys.stderr)
            return 1
        if not dry_run and ("node" in features or "npm" in features):
            if shutil.which("node") is None or shutil.which("npm") is None:
                print("ERROR: Node.js o npm siguen ausentes despues de instalar dependencias.", file=sys.stderr)
                return 1
    else:
        manager = "no requerido"
        print("\nDependencias base: OK")

    if not docker_accessible and (dry_run or shutil.which("docker") is not None):
        started = False
        if shutil.which("systemctl") or dry_run:
            started = _run_bootstrap_step([*privileged, "systemctl", "enable", "--now", "docker"], dry_run=dry_run)
        if not started and shutil.which("service"):
            _run_bootstrap_step([*privileged, "service", "docker", "start"], dry_run=dry_run)

    user = os.environ.get("SUDO_USER") or getpass.getuser() or pwd.getpwuid(os.getuid()).pw_name
    normal_access = docker_accessible
    if not dry_run:
        normal_access = subprocess.run(
            ["docker", "info"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode == 0
    group_activation_required = False
    if user != "root" and not normal_access:
        configured_groups = _group_names(user)
        active_groups = _group_names()
        if "docker" not in configured_groups:
            print(f"\nHabilitando acceso Docker para {user}")
            if not _run_bootstrap_step([*privileged, "usermod", "-aG", "docker", user], dry_run=dry_run):
                return 1
            group_activation_required = True
        elif "docker" not in active_groups:
            group_activation_required = True

    docker_command = ["docker"]
    if not dry_run:
        if not normal_access and privileged:
            elevated_access = subprocess.run([*privileged, "docker", "info"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode == 0
            if elevated_access:
                docker_command = [*privileged, "docker"]
            else:
                print("ERROR: Docker no inicio correctamente. Revisa: systemctl status docker", file=sys.stderr)
                return 1
        elif not normal_access:
            print("ERROR: Docker no esta accesible.", file=sys.stderr)
            return 1

    print("\nPreparando configuraciones privadas")
    if not dry_run:
        for profile_id in PUBLIC_PROFILE_IDS:
            try:
                prepare_scenario_environment(service.root, profile_id)
            except (OSError, UnicodeError, ValueError) as exc:
                print(f"ERROR: no se pudo preparar {profile_id}: {exc}", file=sys.stderr)
                return 1
        if not _prepare_app_environment(service, operations=True):
            return 1
        app_values = _app_environment_values(service)
        pcsc_socket = app_values.get("LAIN5G_PCSC_SOCKET", "/run/pcscd/pcscd.comm")
        print("Preparando el servicio PC/SC del lector SIM")
        if not _ensure_pcsc_host(pcsc_socket):
            print("AVISO: la app y los perfiles seguiran disponibles; el programador SIM necesita un servicio PC/SC activo.")
    else:
        for profile_id in PUBLIC_PROFILE_IDS:
            print(f"$ ./lain5g scenario setup {profile_id}")

    print("\nPreparando los componentes del laboratorio")
    required_image_list = _required_images("all")
    existing_images = (
        {image for image in required_image_list if _image_exists(image, docker_command)}
        if not dry_run
        else set()
    )
    if dry_run:
        for local_image in _required_images("all"):
            context = LOCAL_BUILD_IMAGES.get(local_image)
            if context:
                print(f"$ docker build -t {shlex.quote(local_image)} {shlex.quote(str(service.root / context))}")
            else:
                remote_image = IMAGE_CATALOG.get(local_image, (local_image, ""))[0]
                print(f"$ docker pull {shlex.quote(remote_image)}")
                if remote_image != local_image:
                    print(f"$ docker tag {shlex.quote(remote_image)} {shlex.quote(local_image)}")
        print("\nPreparando las imágenes del IMS real desde el código del repositorio")
        for image, context in REAL_IMS_LOCAL_BUILD_IMAGES.items():
            print(f"$ docker build -t {shlex.quote(image)} {shlex.quote(str(service.root / context))}")
    elif not _download_images("all", docker_command=docker_command, project_root=service.root):
        return 1
    else:
        ims_image_result = _prepare_real_ims_images(
            docker_command=docker_command,
            project_root=service.root,
        )
        if ims_image_result is None:
            return 1

    print("\nPLAN DE PREPARACION" if dry_run else "\nMAQUINA PREPARADA")
    print("\nRESUMEN DE INSTALACION")
    print("Proposito: preparar este equipo para ejecutar Lain5G y sus perfiles con Docker.")
    print(f"Host: {_bootstrap_host_type()}")
    print(f"Sistema: {sys.platform} / {os.uname().machine if hasattr(os, 'uname') else 'arquitectura desconocida'}")
    print(f"Gestor de paquetes: {manager}")
    print(f"Configuracion privada: {'planificada para ' if dry_run else 'preparada para '}{len(PUBLIC_PROFILE_IDS)} perfiles y la aplicacion web")
    if dry_run:
        print(f"Dependencias: planificado {', '.join(ensured_dependencies) if ensured_dependencies else 'sin cambios'} (dry-run; no instalado)")
        print(f"Imagenes: planificadas {len(required_image_list)} imágenes de perfiles y {len(REAL_IMS_LOCAL_BUILD_IMAGES)} imágenes IMS locales (dry-run; no preparadas)")
    else:
        if os.environ.get("LAIN5G_BOOTSTRAP_PYTHON_INSTALLED", "").lower() == "true":
            ensured_dependencies.insert(0, "Python 3.10+ (bootstrap)")
        print(f"Dependencias: {', '.join(ensured_dependencies) if ensured_dependencies else 'todas ya estaban disponibles'}")
        prepared_count = max(0, len(required_image_list) - len(existing_images))
        ims_built, ims_reused = ims_image_result
        print(f"Imagenes Docker de perfiles: {len(required_image_list)} listas ({prepared_count} preparadas ahora, {len(existing_images)} ya estaban presentes)")
        print(f"Imagenes Docker de IMS real: {len(REAL_IMS_LOCAL_BUILD_IMAGES)} listas ({len(ims_built)} preparadas ahora, {len(ims_reused)} ya estaban presentes); comparten Open5GS con los perfiles")
        print(f"Docker accesible para esta sesion: {'si' if normal_access else 'requiere activar permisos'}")
    print(f"Duracion: {_bootstrap_elapsed_seconds(started_monotonic)} s")

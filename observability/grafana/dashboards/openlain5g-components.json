      "id": 6,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": true, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "direction": "backward", "expr": "{job=\"openlain5g\",scenario=~\"$scenario\",service=~\"(pcscf|icscf|scscf|rtpengine|smsc|sip-register|virtual-phones)\"}", "maxLines": 1000, "queryType": "range", "refId": "A" }],
      "title": "IMS voice · Kamailio / SIP / RTP",

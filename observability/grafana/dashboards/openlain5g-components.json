      "targets": [{ "direction": "backward", "expr": "{job=\"openlain5g\",scenario=~\"$scenario\",service=~\".*(mongo|database|provisioner|mysql|mariadb).*\"}", "maxLines": 1000, "queryType": "range", "refId": "A" }],
